{
  "name": "reaxify",
  "private": false,
  "version": "1.3.0",
  "type": "module",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    "./axios": {
      "types": "./dist/axios/index.d.ts",
      "import": "./dist/axios/index.es.js",
      "require": "./dist/axios/index.cjs.js"
    },
    "./components": {
      "types": "./dist/components/index.d.ts",
      "import": "./dist/components/index.es.js",
      "require": "./dist/components/index.cjs.js"
    },
    "./helpers": {
      "types": "./dist/helpers/index.d.ts",
      "import": "./dist/helpers/index.es.js",
      "require": "./dist/helpers/index.cjs.js"
    },
    "./hooks": {
      "types": "./dist/hooks/index.d.ts",
      "import": "./dist/hooks/index.es.js",
      "require": "./dist/hooks/index.cjs.js"
    },
    "./providers": {
      "types": "./dist/providers/index.d.ts",
      "import": "./dist/providers/index.es.js",
      "require": "./dist/providers/index.cjs.js"
    },
    "./types": {
      "types": "./dist/types/index.d.ts"
    },
    "./style.css": {
      "require": "./dist/style.css",
      "default": "./dist/style.css"
    }
  },
  "scripts": {
    "dev": "storybook dev -p 3000",
    "build": "tsc && vite build",
    "release": "npm run build && npm version patch --no-git-tag-version --no-commit-hooks && npm publish",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@tanstack/react-hotkeys": "^0.9.1",
    "iconsax-react": "^0.0.8",
    "react-animate-height": "^3.2.3",
    "react-transition-group": "^4.4.5",
    "tailwind-merge": "^3.5.0"
  },
  "peerDependencies": {
    "axios": ">=1.0.0",
    "react": ">=19.0.0",
    "react-dom": ">=19.0.0"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^3.2.4",
    "@storybook/addon-essentials": "^8.6.14",
    "@storybook/addon-interactions": "^8.6.14",
    "@storybook/addon-links": "^8.6.14",
    "@storybook/addon-onboarding": "^8.6.14",
    "@storybook/blocks": "^8.6.14",
    "@storybook/react": "^8.6.14",
    "@storybook/react-vite": "^8.6.14",
    "@storybook/test": "^8.6.15",
    "@tailwindcss/vite": "^4.1.16",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/react-transition-group": "^4.4.11",
    "@typescript-eslint/eslint-plugin": "^6.14.0",
    "@typescript-eslint/parser": "^6.14.0",
    "@vitejs/plugin-react-swc": "^3.5.0",
    "axios": "^1.13.1",
    "eslint": "^8.55.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.5",
    "eslint-plugin-storybook": "^0.10.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "storybook": "^8.6.14",
    "tailwindcss": "^4.1.16",
    "typescript": "^5.7.2",
    "vite": "^6.3.5",
    "vite-plugin-dts": "^4.5.4",
    "vite-plugin-lib-inject-css": "^2.2.2",
    "vite-plugin-static-copy": "^4.1.0",
    "vite-tsconfig-paths": "^6.1.1"
  }
}
